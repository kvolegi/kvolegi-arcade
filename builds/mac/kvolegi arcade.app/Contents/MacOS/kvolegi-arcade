#!/bin/bash
set -e

DIR="$(cd "$(dirname "$0")" && pwd)"
RES="$DIR/../Resources"
JAR_PATH="$RES/kvolegi-arcade-mac.jar"

JAVA_BIN=""
if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
    JAVA_BIN="$JAVA_HOME/bin/java"
fi

if [ -z "$JAVA_BIN" ] && [ -x "/usr/libexec/java_home" ]; then
    JH="$(/usr/libexec/java_home 2>/dev/null || true)"
    if [ -n "$JH" ] && [ -x "$JH/bin/java" ]; then
        JAVA_BIN="$JH/bin/java"
    fi
fi

if [ -z "$JAVA_BIN" ]; then
    for candidate in \
        "/opt/homebrew/opt/openjdk/bin/java" \
        "/opt/homebrew/opt/openjdk@21/bin/java" \
        "/opt/homebrew/opt/openjdk@17/bin/java" \
        "/usr/local/opt/openjdk/bin/java" \
        "/usr/local/opt/openjdk@21/bin/java" \
        "/usr/local/opt/openjdk@17/bin/java" \
        "/Library/Internet Plug-Ins/JavaAppletPlugin.plugin/Contents/Home/bin/java"
    do
        if [ -x "$candidate" ]; then
            JAVA_BIN="$candidate"
            break
        fi
    done
fi

if [ -z "$JAVA_BIN" ]; then
    for jvm in /Library/Java/JavaVirtualMachines/*/Contents/Home/bin/java; do
        if [ -x "$jvm" ]; then
            JAVA_BIN="$jvm"
            break
        fi
    done
fi

if [ -z "$JAVA_BIN" ]; then
    JAVA_BIN="$(which java 2>/dev/null || true)"
fi

if [ -z "$JAVA_BIN" ] || [ ! -x "$JAVA_BIN" ]; then
    osascript -e 'display alert "kvolegi arcade" message "Java 17 or higher is required to run kvolegi arcade. Please install Java from https://adoptium.net or via Homebrew (brew install openjdk)." as critical'
    exit 1
fi

LOG_FILE="$HOME/Library/Logs/kvolegi-arcade.log"
mkdir -p "$HOME/Library/Logs"

exec "$JAVA_BIN" -Xdock:name="kvolegi arcade" -Xdock:icon="$RES/AppIcon.icns" -jar "$JAR_PATH" "$@" > "$LOG_FILE" 2>&1
